{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Violet Roots",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "-m",
        "http.server",
        "5500",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(?!)"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on",
          "endsPattern": "^Serving HTTP on"
        }
      }
    }
  ]
}
